{
  "openapi": "3.1.0",
  "info": {
    "title": "Device Farm API",
    "version": "3.0.0",
    "description": "Self-hosted test execution platform for Apple Silicon Macs"
  },
  "components": {
    "schemas": {
      "PipelineCreateRequest": {
        "type": "string",
        "description": "Raw YAML document defining the pipeline (name + stages + trigger)"
      },
      "ApiKeyCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "name"
        ],
        "description": "Request body for POST /api/admin/keys"
      },
      "WebhookCreateRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "event": {
            "default": "test.ping",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "payload": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "url"
        ],
        "description": "Register a webhook target — triggers a fire-and-forget ping delivery"
      },
      "DlqListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DlqJob"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "items",
          "count"
        ],
        "additionalProperties": false,
        "description": "GET /api/queue/dlq response — list of dead-lettered webhook delivery jobs"
      },
      "DlqJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "queue": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "created",
              "retry",
              "active",
              "completed",
              "cancelled",
              "failed"
            ]
          },
          "retrycount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "output": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "createdon": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "queue",
          "state",
          "retrycount",
          "data",
          "output",
          "createdon",
          "correlation_id"
        ],
        "additionalProperties": false,
        "description": "A dead-lettered job from the webhook-deliver-dlq queue (flat shape; correlation_id hoisted from envelope)"
      },
      "DrainResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "drained": {
                "type": "boolean",
                "const": true
              },
              "in_flight": {
                "type": "number",
                "const": 0
              },
              "drained_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "drained",
              "in_flight",
              "drained_at"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "drained": {
                "type": "boolean",
                "const": false
              },
              "in_flight": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timeout": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "drained",
              "in_flight",
              "timeout"
            ],
            "additionalProperties": false
          }
        ],
        "type": "object"
      },
      "DrainResumeResponse": {
        "type": "object",
        "properties": {
          "resumed": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "resumed"
        ],
        "additionalProperties": false
      },
      "Hook": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "event": {
            "type": "string",
            "enum": [
              "device.booted",
              "device.shutdown",
              "test.before",
              "test.after"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "platform": {
            "default": "all",
            "type": "string",
            "enum": [
              "android",
              "ios",
              "all"
            ]
          },
          "timeoutMs": {
            "default": 30000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000
          },
          "failOnError": {
            "default": false,
            "type": "boolean"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "event",
          "command",
          "platform",
          "timeoutMs",
          "failOnError",
          "enabled"
        ],
        "additionalProperties": false,
        "description": "Registered lifecycle hook"
      },
      "HookConflict": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number",
            "const": 409
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "additionalProperties": false,
        "description": "RFC 7807 conflict body for duplicate hook names"
      },
      "Pipeline": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "description": "Result of a pipeline create operation — identifier only"
      },
      "PipelineValidationError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number",
            "const": 400
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "additionalProperties": false,
        "description": "RFC 7807 validation error for POST /api/pipelines"
      },
      "JobSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "allocated",
              "running",
              "passed",
              "failed",
              "cancelled",
              "timeout"
            ]
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "platform"
        ],
        "additionalProperties": false,
        "description": "Job identifier + initial queued state returned by POST /api/jobs"
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "allocated",
              "running",
              "passed",
              "failed",
              "cancelled",
              "timeout"
            ]
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          },
          "deviceId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "deviceName": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "metadata": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "finishedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "errorMessage": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "status",
          "platform",
          "deviceId",
          "deviceName",
          "metadata",
          "createdAt",
          "startedAt",
          "finishedAt",
          "errorMessage"
        ],
        "additionalProperties": false,
        "description": "Phase 23 Plan 23-03 (DEBT-02 / CLI-05) — Full job record including allocated device name (joined from devices.name). deviceName MUST be non-empty when deviceId is present (cross-field invariant enforced at runtime by Zod refine; not expressible in JSON Schema). Phase 23 Plan 23-07 reinstated after Plan 23-05 drain regen dropped the schema."
      },
      "ArtifactList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ArtifactSummary"
        },
        "description": "All artifacts produced by a job"
      },
      "ArtifactSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "screenshot",
              "memory",
              "log"
            ]
          },
          "filePath": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "fileSizeBytes": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "compressed": {
            "type": "boolean"
          },
          "compressedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "jobId",
          "type",
          "filePath",
          "fileName",
          "mimeType",
          "fileSizeBytes",
          "compressed",
          "compressedAt",
          "createdAt"
        ],
        "additionalProperties": false,
        "description": "Single artifact row as stored in the artifacts table"
      },
      "DeviceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/DeviceSummary"
        },
        "description": "Live pool-manager view of all registered devices"
      },
