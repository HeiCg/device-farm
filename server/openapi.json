  "paths": {
    "/api/queue/dlq": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DlqListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/drain": {
      "post": {
        "parameters": [
          {
            "schema": {
              "default": 300,
              "type": "integer",
              "minimum": 1,
              "maximum": 1800
            },
            "in": "query",
            "name": "timeout"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrainResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/drain/resume": {
      "post": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrainResumeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/hooks": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "device.booted",
                      "device.shutdown",
                      "test.before",
                      "test.after"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "platform": {
                    "default": "all",
                    "type": "string",
                    "enum": [
                      "android",
                      "ios",
                      "all"
                    ]
                  },
                  "timeoutMs": {
                    "default": 30000,
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 300000
                  },
                  "failOnError": {
                    "default": false,
                    "type": "boolean"
                  },
                  "enabled": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "event",
                  "command"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hook"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HookConflict"
                }
              }
            }
          }
        }
      }
